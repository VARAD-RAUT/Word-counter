---
interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Word Counter Online – Free Word & Character Counter',
	description = 'Count words, characters, sentences, paragraphs and reading time instantly with our free online word counter. Fast, accurate and private.',
	image = '/og-word-counter.svg',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const imageUrl = new URL(image, canonicalUrl).toString();
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/mark.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fafafa" />
		<script is:inline>
			(() => {
				try {
					const storedTheme = localStorage.getItem('zyvento-theme');
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (storedTheme === 'dark' || (!storedTheme && prefersDark)) document.documentElement.dataset.theme = 'dark';
				} catch {}
			})();
		</script>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="zyvento.io" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<title>{title}</title>
	</head>
	<body class="bg-canvas-soft text-ink antialiased">
		<slot />
	</body>
</html>
